{
  "name": "jarvis-dashboard",
  "private": true,
  "version": "3.0.1",
  "description": "Calmon Studio — Plataforma de IA Local-First e Multi-Agentes",
  "author": "Alexandre Calmon",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "tsc && vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/server.mjs --packages=external --external:vite --banner:js=\"import { createRequire as __cr } from 'module'; const require = __cr(import.meta.url);\"",
    "desktop:dev": "npm run build && npm run build:server && electron .",
    "desktop:win": "npm run build && npm run build:server && electron-builder --win nsis portable",
    "desktop:linux": "npm run build && npm run build:server && electron-builder --linux AppImage",
    "desktop:mac": "npm run build && npm run build:server && electron-builder --mac dmg zip",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test server/*.test.ts server/brain/*.test.ts src/router.test.ts src/services/*.test.ts src/shared/state/*.test.ts firestore.rules.test.ts",
    "test:unit": "tsx --test server/*.test.ts server/brain/*.test.ts src/router.test.ts src/services/*.test.ts firestore.rules.test.ts",
    "test:server": "tsx --test server/*.test.ts server/brain/*.test.ts firestore.rules.test.ts",
    "test:services": "tsx --test src/router.test.ts src/services/*.test.ts",
    "test:router": "tsx --test src/router.test.ts",
    "test:security": "tsx --test src/services/sentinelSecurity.test.ts firestore.rules.test.ts server/providerEngine.test.ts",
    "test:agents": "tsx --test src/services/agent*.test.ts",
    "test:brain": "tsx --test server/brain/*.test.ts src/services/secondBrain.test.ts src/services/brainArchitectureEngine.test.ts",
    "test:store": "tsx --test src/services/unifiedStoreEngine.test.ts src/services/modulePackEngine.test.ts",
    "test:logs": "tsx --test src/services/logExportEngine.test.ts",
    "test:models": "tsx --test src/services/providerHealthMetrics.test.ts src/services/providerPingValidation.test.ts server/providerEngine.test.ts",
    "test:skills": "tsx --test src/services/unifiedStoreEngine.test.ts",
    "test:architecture": "tsx --test server/architectureAnalyzer.test.ts src/services/brainArchitectureEngine.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "firebase": "^13.4.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "pg": "^8.23.1",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^2.0.0"
  },
  "build": {
    "appId": "com.calmonstudio.hub",
    "productName": "Calmon Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "models/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "Calmon-Studio-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "artifactName": "Calmon-Studio-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "Calmon-Studio-${version}-${arch}.${ext}"
    }
  }
}
