# ==========================================================
# JARVIS AI Hub — Variáveis de Ambiente do Servidor ("Cérebro")
# Copie para .env e preencha apenas o necessário.
# NUNCA coloque chaves reais em .env.example ou no repositório.
# ==========================================================

# Modo do banco de dados:
#   local_sqlite    -> Usuário comum sem Docker (salva em ~/JARVIS-Brain/brain.db)
#   docker_postgres -> Usuário avançado com Docker Compose (PostgreSQL 16 + pgvector + Redis)
BRAIN_MODE=local_sqlite
BRAIN_NAME=Cérebro JARVIS Local
PORT=3000

# Modo Local (Sem Docker)
SQLITE_DATA_DIR=~/JARVIS-Brain

# Modo Docker (PostgreSQL + pgvector + Redis)
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=
POSTGRES_DB=jarvis_brain
DATABASE_URL=
REDIS_URL=redis://localhost:6379

# Segurança de sessão (defina uma string aleatória longa em produção)
JWT_SECRET=

# Chave da API Gemini no servidor (modelos de texto, imagem e vídeo)
GEMINI_API_KEY=

# Token opcional do GitHub para ampliar o limite de leitura de repositórios públicos (somente leitura)
GITHUB_TOKEN=

# Ollama local opcional (detectado automaticamente quando ativo)
OLLAMA_HOST=http://127.0.0.1:11434

