# ==========================================================
# JARVIS AI Hub — Variáveis de Ambiente do Servidor ("Cérebro")
# Copie para .env e preencha apenas o necessário.
# NUNCA coloque chaves reais em .env.example ou no repositório.
# ==========================================================

# Modo do banco de dados:
#   local_sqlite    -> Usuário comum sem Docker (salva em ~/JARVIS-Brain/brain.db)
#   docker_postgres -> Usuário avançado com Docker Compose (PostgreSQL 16 + pgvector + Redis)
BRAIN_MODE=local_sqlite
BRAIN_NAME=Cérebro JARVIS Local
PORT=3000

# Modo Local (Sem Docker)
SQLITE_DATA_DIR=~/JARVIS-Brain

# Modo Docker (PostgreSQL + pgvector + Redis)
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=
POSTGRES_DB=jarvis_brain
DATABASE_URL=
REDIS_URL=redis://localhost:6379

# Segurança de sessão e criptografia do cofre (defina strings aleatórias longas em produção)
JWT_SECRET=
KEYVAULT_MASTER_KEY=
BOOTSTRAP_ADMIN_EMAIL=alexandrecalmonjunior@gmail.com

# Tokens internos entre serviços poliglotas (Node Brain <-> Python Worker <-> Go Gateway)
INTERNAL_WORKER_TOKEN=
INTERNAL_GATEWAY_TOKEN=

# Chave da API Gemini no servidor (modelos de texto, imagem e vídeo)
GEMINI_API_KEY=

# Provedores externos opcionais (também configuráveis de forma criptografada na sessão em Configurações)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=

# Token opcional do GitHub para ampliar o limite de leitura de repositórios públicos (somente leitura)
GITHUB_TOKEN=

# Ollama local opcional (detectado automaticamente quando ativo)
OLLAMA_HOST=http://127.0.0.1:11434

# Endpoints internos da arquitetura poliglota (Docker Compose)
PYTHON_WORKER_URL=http://127.0.0.1:8001
GO_GATEWAY_PORT=8080

# Object Storage Plugável (Opcional — omita para usar disco local confinado)
# OBJECT_STORAGE_PROVIDER: local | s3 | gcs | minio
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Sandbox Plugável (Opcional — local_confined por padrão; use docker_ephemeral em VPS)
SANDBOX_DRIVER=local_confined
SANDBOX_DOCKER_IMAGE=node:22-alpine

# Segredos de Webhook para Gateway de Canais 24/7 (Telegram, Discord, Slack, WhatsApp)
CHANNEL_TELEGRAM_WEBHOOK_SECRET=
CHANNEL_DISCORD_WEBHOOK_SECRET=
CHANNEL_SLACK_WEBHOOK_SECRET=
CHANNEL_WHATSAPP_WEBHOOK_SECRET=

# Tokens de Saída para Respostas Automáticas nos Canais 24/7 (somente servidor)
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Permitir endpoints HTTP locais para servidores MCP internos (false por padrão por segurança)
MCP_ALLOW_LOCAL_HTTP=false
